# Supabase Configuration
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (for API routes like /api/join)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Intake (Supabase Edge Function secret - set via `supabase secrets set`)
# INBOUND_EMAIL_WEBHOOK_SECRET=your-random-secret-here

# Wild Apricot Integration (optional)
# Get these from WA: Settings > Authorized Applications > create Server Application
# WILDAPRICOT_API_KEY=your-wa-api-key-here
# WILDAPRICOT_ACCOUNT_ID=your-wa-account-id-here

# 32+ char random secret used to sign QR tokens
GUEST_TOKEN_SECRET=

# GoHighLevel — leave blank in dev for the mock client
GHL_API_KEY=
GHL_LOCATION_ID=

# Resend — leave blank in dev for the mock client
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@businessleadersofcharlotte.com
